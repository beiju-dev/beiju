{
  "name": "beiju",
  "version": "0.2.0",
  "description": "An analytical query builder for Node.js, with a Semantic Layer and bilingual API (English / Portuguese).",
  "keywords": [
    "sql",
    "query-builder",
    "postgresql",
    "olap",
    "analytics",
    "semantic-layer",
    "window-functions",
    "typescript"
  ],
  "homepage": "https://github.com/beiju-dev/beiju#readme",
  "bugs": "https://github.com/beiju-dev/beiju/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beiju-dev/beiju.git"
  },
  "license": "MIT",
  "author": "Junior Teixeira (junior-zip)",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.21.0"
  }
}
